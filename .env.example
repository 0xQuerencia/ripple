# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Get a key at https://aistudio.google.com/apikey. Use a separate key for the server you deploy to.
GEMINI_API_KEY=

# gemma-4-26b-a4b-it (fast, default) or gemma-4-31b-it (larger)
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- Only needed when deployed (see docs/DEPLOY.md) ---

# How many reverse proxies sit in front of the server (0 = none; Caddy/nginx = 1; Cloudflare + Caddy = 2).
TRUSTED_PROXY_HOPS=0

# Questions per visitor per minute, and across everyone per hour (so a public URL cannot spend the whole quota).
RATE_LIMIT_PER_MINUTE=12
GLOBAL_LIMIT_PER_HOUR=300
