{
  "name": "ripple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "sprites": "node scripts/make-sprites.mjs",
    "format": "prettier --write src shared server scripts tests vite.config.js playwright.config.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "vite": "^6.3.5"
  },
  "license": "MIT",
  "description": "Little causes, big consequences. Drop a cause on a map of 12 connected systems and watch Gemma 4 reason about the ripples."
}
